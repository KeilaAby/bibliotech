{% extends 'base.html.twig' %}

{% block title %}Détails du livres
{% endblock %}

{% block body %}

	<div class="w-full flex items-start space-x- shadow-md mb-8 pb-4">

    {# image du livre #}
		<div class="w-96 shadow-xl">
			<figure>
				<img class="object-cover size-100" src="{{asset('build/images/'~ book.image)}}" alt="Livre"/>
			</figure>
		</div>

		<div class="w-full px-6">

      {# entête #}
			<div class="flex items-start justify-between">
        {# petite description #}
				<div class="space-y-1">
          <h2 class="text-3xl font-bold text-wrap">{{book.title}}</h2>
          <div class="flex space-x-2"> 
    {% if livreCategories is not empty %}
        {% for category in livreCategories %}
            <div class="badge badge-outline badge-primary">{{category.name}}</div>

        {% endfor %}
    {% endif %}
          </div>
         
          <p class="text-lg font-thin">{{book.author}}</p>
          <button class="text-lg text-left font-semibold">{{book.price}}€</button>
          <div class="text-base-content flex">
            <span class="text-warning text-xl">4.5</span>
            <div class="rating">
              <input type="radio" name="rating-2" class="mask mask-star-2 bg-orange-400" aria-label="1 star" />
              <input type="radio" name="rating-2" class="mask mask-star-2 bg-orange-400" aria-label="2 star"  />
              <input type="radio" name="rating-2" class="mask mask-star-2 bg-orange-400" aria-label="3 star" />
              <input type="radio" name="rating-2" class="mask mask-star-2 bg-orange-400" aria-label="4 star" checked="checked"/>
              <input type="radio" name="rating-2" class="mask mask-star-2 bg-orange-400" aria-label="5 star" />
            </div>
          </div>
        </div>
        {# bouton d'ajout au panier #}
        <div class="flex flex-col space-y-2">
          <button class="btn btn-base-300 btn-lg">Ajouter au panier</button>
          <button class="btn btn-primary btn-lg">Acheter</button>
			  </div>
      </div>

      <div class="divider"></div>

      {# description #}
			<div>
        <p class="text-lg font-thin text-info-content text-justify">
          {{book.description}}
        </p>
      </div>

      <div class="divider"></div>
      {# détails #}
			<div>
       
        <div class="flex space-y-1 justify-between">
          <p class="text-lg font-thin"><b>ISBN :</b> {{book.isbn}}</p>
          <p class="text-lg font-thin"><b>Date de publication:</b> {{book.datePub|date('d/m/Y')}}</p>
          <p class="text-lg font-thin"><b>Langue:</b> {{book.lang}}</p>
          <p class="text-lg font-thin"><b>Éditeur:</b> {{book.editor}}</p>
          <p class="text-lg font-thin"><b>Poids:</b> {{book.poids}}</p>
          <p class="text-lg font-thin"><b>Dimension : </b> {{book.dimension}}</p>
        </div>
      
      </div>
    </div>
	</div>


